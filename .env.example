# Generate a base64-encoded 32-byte key for production patient data encryption.
PATIENT_DATA_KEY=

# MSG91 signup OTP configuration.
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=
# Separate MSG91 widget with Mobile Integration enabled; keep the web widget above unchanged.
MSG91_MOBILE_WIDGET_ID=
MSG91_MOBILE_WIDGET_TOKEN=
MSG91_AUTH_KEY=
# Optional fallback for direct SendOTP API use; not needed by the OTP Widget SDK.
MSG91_OTP_TEMPLATE_ID=

# ElevenLabs private agent configuration. Keep the API key server-side only.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=agent_your_agent_id
# Optional native English/Hindi voices for the cached page narration. If omitted,
# the server reuses the configured agent voice.
ELEVENLABS_TTS_VOICE_ID_EN=
ELEVENLABS_TTS_VOICE_ID_HI=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Self-hosted Aarogyam model. Keep both values on the site server only.
AAROGYAM_API_URL=https://your-lightning-api-host
AAROGYAM_API_KEY=

# Temporary, reusable patient-app QR for testing only. Choose the real branch ID from /api/hospital-branches.
# Keep disabled for real hospital use; this QR does not prove physical presence.
MOBILE_INTAKE_STATIC_QR_ENABLED=0
MOBILE_INTAKE_STATIC_HOSPITAL_ID=

# Gemini generates clinical summaries, answers doctor questions, and extracts uploaded documents.
# Use GEMINI_API_KEY for an AI Studio key, or GEMINI_ACCESS_TOKEN for a short-lived OAuth token.
GEMINI_API_KEY=
GEMINI_ACCESS_TOKEN=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=45000

# Optional temporary testing access. Keep disabled outside controlled testing.
ALLOW_TEST_DEVICE_CODE=false
TEST_DEVICE_CODE=
TEST_DEVICE_SESSION_HOURS=24
